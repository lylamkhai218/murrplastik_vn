<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Gộp chuyển hướng HTTP -> HTTPS và WWW -> Non-WWW (Tối ưu chỉ qua 1 lần chuyển hướng)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Chặn truy cập trực tiếp các file nhạy cảm và file ẩn (.env, .git, .log)
  RewriteRule ^(\.env|\.git|\.htaccess|\.user_uploaded|Logs\.csv|All_Logs\.csv) - [F,L,NC]

  # 3. Chuyển hướng các URL sản phẩm cũ (mã hãng) sang URL tiếng Việt mới (301 Redirect)
  RewriteRule ^products/acs(\.html)?$ /products/tem-nhan-va-he-thong-dan-nhan [R=301,L,NC]
  RewriteRule ^products/suv(\.html)?$ /products/ong-luon-day-cap-va-phu-kien [R=301,L,NC]
  RewriteRule ^products/kdh(\.html)?$ /products/he-thong-dau-vao-cap-va-gia-do [R=301,L,NC]
  RewriteRule ^products/efk(\.html)?$ /products/mang-xich-nhua-luon-cap [R=301,L,NC]
  RewriteRule ^products/aur(\.html)?$ /products/phu-kien-robot-va-tu-dong-hoa [R=301,L,NC]

  # 4. Chuyển hướng URL F&B cũ sang thư mục Việt hóa mới (301 Redirect)
  RewriteRule ^industries/foodbeverage/?(index\.html)?$ /industries/thuc-pham-va-do-uong/ [R=301,L,NC]

  # 5. Loại bỏ dấu gạch chéo cuối (trailing slash) của URL không phải thư mục
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # 6. Tự động chuyển hướng từ index.html sang URL sạch (301 Redirect)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*/)?index\.html\ HTTP/ [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # 7. Tự động ẩn đuôi .html bằng cách Redirect 301 từ file.html sang file (301 Redirect) cho các trang khác
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/ [NC]
  RewriteRule ^(.+)\.html$ /%1 [R=301,L]

  # 8. Định tuyến nội bộ: Cho phép truy cập URL không đuôi nhưng máy chủ vẫn gọi file .html tương ứng
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 3. Nén GZIP & DEFLATE (Giảm 70-80% dung lượng HTML/CSS/JS/SVG khi truyền tải)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml font/woff font/woff2 application/font-woff2
</IfModule>

# 4. Cấu hình Browser Caching (Lưu bộ nhớ đệm trình duyệt 1 năm cho file tĩnh)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # HTML & Dynamic pages - NO CACHE to ensure immediate updates across CDN and browsers
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  
  # CSS và JavaScript (1 năm)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  
  # Web Fonts (1 năm)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  
  # Hình ảnh & Media Tĩnh (1 năm)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 5. HTTP Headers: Tối ưu Cache-Control cho File Tĩnh & Bảo mật HTML
<IfModule mod_headers.c>
  # 5.1 Ép Browser Cache triệt để cho static assets (JS, CSS, WebP, PNG, SVG, WOFF2)
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # 5.2 Dynamic HTML/PHP: Không cache để luôn cập nhật nội dung mới nhất
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "private, no-cache, no-store, must-revalidate, max-age=0, proxy-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
  
  # 5.3 Security Hardening Headers (Tiêu chuẩn An ninh ECC AgentShield)
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Thiết lập mã hóa UTF-8 mặc định cho tất cả các file
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json
